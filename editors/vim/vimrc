  autocmd BufAdd,BufDelete,BufWritePost * redrawtabline
augroup END

" ── Yank 高亮：matchadd + timer，150 ms 后自动消除 ──
if exists('##TextYankPost') && has('timers')
  augroup YankHighlight
    autocmd!
    autocmd TextYankPost * silent! call s:yank_highlight()
  augroup END
  function! s:yank_highlight() abort
    let l:m = matchadd('IncSearch',
          \ '\%' . line("'[") . 'l\%>' . (col("'[") - 1) .
          \ 'v\%<' . (col("']") + 1) . 'v')
    call timer_start(150, {-> execute('silent! call matchdelete(' . l:m . ')')})
  endfunction
endif
