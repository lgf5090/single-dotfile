" =============================================================================
"  Vim 9+ Pure-Builtins Configuration
"  No third-party plugins. Place at ~/.vimrc or ~/.vim/vimrc.
" =============================================================================

" ─── 1. Defaults ──────────────────────────────────────────────────────────────
set nocompatible
set encoding=utf-8
scriptencoding utf-8

syntax enable
filetype plugin indent on

" ─── 2. Options ───────────────────────────────────────────────────────────────
" 行号
set number
set relativenumber

" 缩进
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set smartindent
set autoindent

" 搜索
set hlsearch
set incsearch
set ignorecase
set smartcase

" 外观
if has('termguicolors') | set termguicolors | endif
set cursorline
set signcolumn=yes
set scrolloff=8
set sidescrolloff=8
set nowrap
set colorcolumn=80
set noshowmode   " 由 statusline 的模式指示器接管
set showmatch    " 括号高亮配对
set matchtime=2

" 文件 / Buffer
set hidden            " 切换 buffer 无需强制保存（新增）
set fileencoding=utf-8
set noswapfile
set nobackup
set undofile
let &undodir = expand('~/.vim/undo')
silent! call mkdir(&undodir, 'p', 0700)

" 分屏
set splitright
set splitbelow

" 补全
set completeopt=menu,menuone,noselect,popup
set pumheight=10
set shortmess+=c

" 杂项
set mouse=a
set backspace=indent,eol,start
if has('clipboard') | set clipboard=unnamedplus | endif
set updatetime=250
set timeoutlen=300
set list
set listchars=tab:»\ ,trail:·,nbsp:␣
set ttimeout
set ttimeoutlen=10
set history=1000
set lazyredraw

" :find — 配合 wildmenu 充当低配模糊查找
set path+=**
set wildmenu
set wildmode=longest:full,full
set wildignore+=*/node_modules/*,*/.git/*,*/target/*,*/dist/*,*/build/*,*.o,*.pyc

" :grep — 优先使用 ripgrep
if executable('rg')
  set grepprg=rg\ --vimgrep\ --no-heading\ --smart-case
  set grepformat=%f:%l:%c:%m
endif

" ─── 3. 配色方案 ──────────────────────────────────────────────────────────────
" Vim 9 内置: habamax / retrobox / sorbet / wildcharm / lunaperche / quiet
silent! colorscheme habamax

" ─── 4. Statusline & Tabline ──────────────────────────────────────────────────
"  修复原始 bug：set statusline+=...\ 末尾的 \ 会被追加为字面反斜杠，
"  导致状态栏显示 "zsh\ 1:1\ 12%\"。
"  解决方案：改用 %!MyStatusline() 函数，在 Vimscript 字符串里拼装，
"  彻底避免 :set 命令中的转义陷阱。
set laststatus=2
set showtabline=2

" ── 4-a  自定义高亮组（每次 :colorscheme 后重置）──────────────────────────
function! s:setup_hl() abort
  " 模式指示器：Normal=蓝 / Insert=绿 / Visual=橙 / Replace=红 / Command=紫
  hi SLModeN   guibg=#5f87af guifg=#1c1c1c gui=bold   ctermbg=67  ctermfg=234 cterm=bold
  hi SLModeI   guibg=#87af5f guifg=#1c1c1c gui=bold   ctermbg=107 ctermfg=234 cterm=bold
  hi SLModeV   guibg=#d7875f guifg=#1c1c1c gui=bold   ctermbg=173 ctermfg=234 cterm=bold
  hi SLModeR   guibg=#d75f5f guifg=#ffffff gui=bold   ctermbg=167 ctermfg=231 cterm=bold
  hi SLModeC   guibg=#875fd7 guifg=#ffffff gui=bold   ctermbg=98  ctermfg=231 cterm=bold
  " 状态栏各区段
  hi SLGit     guibg=#2d2d2d guifg=#87af87 gui=NONE   ctermbg=236 ctermfg=108
  hi SLFile    guibg=#1e1e1e guifg=#d0d0d0 gui=NONE   ctermbg=234 ctermfg=252
  hi SLMod     guibg=#1e1e1e guifg=#d7875f gui=bold   ctermbg=234 ctermfg=173 cterm=bold
  hi SLInfo    guibg=#141414 guifg=#767676 gui=NONE   ctermbg=233 ctermfg=243
  hi SLPos     guibg=#2d2d2d guifg=#eeeeee gui=NONE   ctermbg=236 ctermfg=255
  hi SLPct     guibg=#141414 guifg=#767676 gui=NONE   ctermbg=233 ctermfg=243
  " 标签栏
  hi TLSel     guibg=#5f87af guifg=#1c1c1c gui=bold   ctermbg=67  ctermfg=234 cterm=bold
  hi TLSelMod  guibg=#5f87af guifg=#d75f00 gui=bold   ctermbg=67  ctermfg=166 cterm=bold
  hi TLNorm    guibg=#2d2d2d guifg=#8a8a8a gui=NONE   ctermbg=236 ctermfg=245
  hi TLNormMod guibg=#2d2d2d guifg=#d7875f gui=bold   ctermbg=236 ctermfg=173 cterm=bold
  hi TLFill    guibg=#141414 guifg=#3a3a3a gui=NONE   ctermbg=233 ctermfg=238
endfunction
augroup StatusHL
  autocmd!
  autocmd ColorScheme * call s:setup_hl()
augroup END
call s:setup_hl()

