" ── 4-c  Git 分支（事件驱动缓存，避免 statusline 高频调用 system()）─────────
let s:_git_branch = ''
function! s:update_git_branch() abort
  " 跳过特殊 buffer（quickfix / help / terminal 等）
  if &buftype !=# '' | return | endif
  let l:dir = !empty(expand('%:p')) ? expand('%:p:h') : getcwd()
  let l:b   = trim(system(
        \ 'git -C ' . shellescape(l:dir) .
        \ ' rev-parse --abbrev-ref HEAD 2>/dev/null'))
  " v:shell_error != 0 表示不在 git 仓库；'HEAD' 表示 detached HEAD
  let s:_git_branch = (v:shell_error == 0 && !empty(l:b) && l:b !=# 'HEAD')
        \ ? l:b : ''
endfunction
augroup GitBranch
  autocmd!
  autocmd BufEnter,FocusGained,DirChanged * call s:update_git_branch()
augroup END
call s:update_git_branch()

" ── 4-d  Statusline 函数 ──────────────────────────────────────────────────────
" 换行格式映射：内部名称 → 可读缩写
let s:ff_map = {'unix': 'LF', 'dos': 'CRLF', 'mac': 'CR'}

function! MyStatusline() abort
  let l:info = get(s:mode_map, mode(), ['??????', 'SLModeN'])

  " ── 左侧 ──────────────────────────────────────────────────────────────────
  " 彩色模式块
  let l:s  = '%#' . l:info[1] . '# ' . l:info[0] . ' '

  " Git 分支（⎇ = U+2387；若终端字体不支持，改为 @ 或 git: 即可）
  if !empty(s:_git_branch)
    let l:s .= '%#SLGit# ⎇ ' . s:_git_branch . ' '
  endif

  " 文件名
  let l:s .= '%#SLFile# %f '

  " 修改 / 只读标志（单独着色，醒目显示）
  if getbufvar('%', '&modified')
    let l:s .= '%#SLMod#[+]%#SLFile# '
  endif
  if &readonly
    let l:s .= '%#SLMod#[RO]%#SLFile# '
  endif

  " ── 右侧 ──────────────────────────────────────────────────────────────────
  let l:s  .= '%='

  let l:ft  = empty(&filetype) ? 'none' : &filetype
  let l:enc = empty(&fileencoding) ? &encoding : &fileencoding
  let l:ff  = get(s:ff_map, &fileformat, &fileformat)

  " filetype · 编码 [换行] │ 行:列 │ 百分比
  let l:s .= '%#SLInfo# ' . l:ft . '  ' . l:enc . ' [' . l:ff . '] '
  let l:s .= '%#SLPos# %l:%c '
  let l:s .= '%#SLPct# %p%% '
  return l:s
endfunction

set statusline=%!MyStatusline()

" ── 4-e  Tabline 函数 ─────────────────────────────────────────────────────────
" ● (U+25CF) 表示已修改；若字体不支持，改为 * 即可
function! MyTabline() abort
  let l:s   = ''
  let l:cur = bufnr('%')
  for l:b in range(1, bufnr('$'))
    if !buflisted(l:b) | continue | endif
    let l:name = fnamemodify(bufname(l:b), ':t')
    let l:name = empty(l:name) ? '[No Name]' : l:name
    let l:mod  = getbufvar(l:b, '&modified')
    if l:b == l:cur
      " 当前 buffer：蓝底高亮
      let l:s .= '%#TLSel# ' . l:b . ' ' . l:name . ' '
      if l:mod | let l:s .= '%#TLSelMod#●%#TLSel# ' | endif
    else
      " 其他 buffer：灰底
      let l:s .= '%#TLNorm# ' . l:b . ' ' . l:name . ' '
      if l:mod | let l:s .= '%#TLNormMod#●%#TLNorm# ' | endif
    endif
  endfor
  return l:s . '%#TLFill#'
endfunction

set tabline=%!MyTabline()

