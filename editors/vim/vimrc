" ─── 8. 自动命令 ──────────────────────────────────────────────────────────────
" ── 保存前去除尾随空白（跳过尾随空格有意义的 filetype）──
augroup TrimWhitespace
  autocmd!
  autocmd BufWritePre * call s:trim_trailing()
augroup END
function! s:trim_trailing() abort
  let l:skip = {'markdown':1,'gitcommit':1,'mail':1,'diff':1,'patch':1}
  if has_key(l:skip, &filetype) | return | endif
  let l:pos = getpos('.')
  keeppatterns %s/\s\+$//e
  call setpos('.', l:pos)
endfunction

" ── 特定 filetype 使用 2-space 缩进 ──
augroup IndentOverride
  autocmd!
  autocmd FileType lua,javascript,typescript,html,css,json,yaml
        \ setlocal tabstop=2 shiftwidth=2
augroup END

